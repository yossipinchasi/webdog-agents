{
  "name": "columbia-ai-agents-kit",
  "private": true,
  "type": "module",
  "description": "Build an agent for Columbia AI Agents: a manifest and three functions, checked by the same gate the platform runs.",
  "engines": { "node": ">=22.6" },
  "scripts": {
    "agent:new": "node --experimental-strip-types scripts/agent-new.ts",
    "agent:record": "node --experimental-strip-types scripts/agent-record.ts",
    "agent:test": "node --experimental-strip-types scripts/agent-test.ts",
    "agent:check": "node --experimental-strip-types scripts/agent-check.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
